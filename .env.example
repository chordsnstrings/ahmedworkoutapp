# Copy to .env and edit before `docker compose up -d`.

# --- Database (compose creates this Postgres) ---
POSTGRES_USER=ocpp
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=ocpp

# --- App ---
# Generate a strong secret, e.g.  openssl rand -hex 32
JWT_SECRET=change-me-to-a-64-char-hex-secret
# Public URL chargers and browsers reach (used to advertise OCPI endpoints).
# Use https:// in production; OCPP then connects over wss://
PUBLIC_URL=https://csms.example.com
HOST_PORT=8080
CURRENCY=USD
OCPI_COUNTRY_CODE=US
OCPI_PARTY_ID=VLT

# --- Optional integrations ---
# Enables the Claude-powered ops assistant (otherwise a local briefing is shown).
ANTHROPIC_API_KEY=
# Enables real Stripe PaymentIntents (otherwise a mock gateway settles instantly).
STRIPE_SECRET_KEY=
